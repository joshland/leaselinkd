[Unit]
Description=Synchronize Kea DHCP leases to OPNsense Unbound overrides
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leaselinkd
Group=leaselinkd
ExecStart=/usr/bin/leaselinkd
LoadCredential=leaselinkd-secrets:/etc/leaselinkd/secrets.json
Environment=LEASELINKD_SECRETS=%d/leaselinkd-secrets
Restart=on-failure
RestartSec=2
RuntimeDirectory=leaselinkd
RuntimeDirectoryMode=0750
StateDirectory=leaselinkd
StateDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
